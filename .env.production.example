# ============================================================
# Variablat e mjedisit për PRODHIM (Hostinger "Deploy Web App")
# Kopjo këtë skedar si ".env" në panelin e Hostinger-it
# (te "Environment variables" e aplikacionit Node.js) dhe plotëso
# vlerat reale — MOS e ngarko këtë skedar në GitHub me vlera reale.
# ============================================================

# 1) Sekreti i Payload-it — gjenero një varg të gjatë e rastësor
#    (mund të përdorësh një gjenerues fjalëkalimesh, 40+ shenja)
PAYLOAD_SECRET=

# 2) Baza e të dhënave — Postgres nga Supabase (falas)
#    Krijo llogari te https://supabase.com → New Project →
#    Project Settings → Database → "Connection string" (Transaction pooler)
POSTGRES_URI=

# 3) Ruajtja e fotove (Media) — Supabase Storage (S3-compatible)
#    Te Supabase: Storage → krijo bucket "media" (publik) →
#    Project Settings → API → gjeni URL-në dhe çelësat aty.
#    S3_ENDPOINT është zakonisht: https://<project-ref>.supabase.co/storage/v1/s3
S3_BUCKET=media
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 4) Email për njoftime porosish (opsionale — pa këto, porositë thjesht
#    ruhen në admin panel pa dërguar email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ORDER_EMAIL_TO=orders@fillers-ks.com
# ORDER_EMAIL_FROM=
